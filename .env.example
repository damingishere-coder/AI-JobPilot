# Docker host ports
BACKEND_PORT=8888
FRONTEND_PORT=6866

# Spring Boot runtime
SERVER_PORT=8888
APP_AUTO_OPEN_BROWSER=false
SPRING_DATASOURCE_URL=jdbc:sqlite:/workspace/db/getjobs.db
LOGGING_FILE_NAME=/workspace/logs/get-jobs.log
TZ=Asia/Shanghai
JAVA_OPTS=-Dfile.encoding=UTF-8 -Dsun.stdout.encoding=UTF-8 -Dsun.stderr.encoding=UTF-8

# AI / model providers. Keep real keys in .env or in the app UI, never in git.
OPENAI_API_KEY=
HUAWEI_API_KEY=
BASE_URL=
API_KEY=
MODEL=
OLLAMA_BASE_URL=http://host.docker.internal:11434

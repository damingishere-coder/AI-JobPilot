# 投递牛马环境变量示例
#
# 说明：
# 1. 不要把真实 .env 提交到 Git。
# 2. Windows 本机启动时，优先双击 start_windows.bat；它会自动设置数据库、日志和浏览器资料目录。
# 3. Docker 启动时，docker compose 会读取项目根目录的 .env；不创建 .env 也能使用下面的默认值。
# 4. AI Key、Cookie、账号密码、简历文件都属于敏感信息，只能保存在本机。

# Docker 端口
BACKEND_PORT=8888
FRONTEND_PORT=6866

# 前端 API 配置
# Windows 本机开发通常保持 API_BASE_URL 为空，前端会通过 /api 代理到后端。
API_BASE_URL=
# Docker 内部后端服务名是 backend；Windows 本机手动前端开发可改为 http://localhost:8888。
API_PROXY_TARGET=http://backend:8888

# Spring Boot 运行配置
SERVER_PORT=8888
APP_AUTO_OPEN_BROWSER=false
TZ=Asia/Shanghai
JAVA_OPTS=-Dfile.encoding=UTF-8 -Dsun.stdout.encoding=UTF-8 -Dsun.stderr.encoding=UTF-8

# Docker 默认目录
SPRING_DATASOURCE_URL=jdbc:sqlite:/workspace/db/getjobs.db
LOGGING_FILE_NAME=/workspace/logs/get-jobs.log
APP_DATA_DIR=/workspace/data
APP_OUTPUT_DIR=/workspace/output
APP_CACHE_DIR=/workspace/target/cache
APP_LOG_DIR=/workspace/logs
APP_BROWSER_USER_DATA_DIR=/workspace/chrome-profile

# Windows 本机路径示例。需要时复制到自己的 .env 或系统环境变量，再把 YourName 改成你的用户名。
# APP_DATA_DIR=C:\Users\YourName\Documents\AI-JobPilot\data
# APP_OUTPUT_DIR=C:\Users\YourName\Documents\AI-JobPilot\output
# APP_CACHE_DIR=C:\Users\YourName\Documents\AI-JobPilot\target\cache
# APP_LOG_DIR=C:\Users\YourName\Documents\AI-JobPilot\logs
# APP_BROWSER_USER_DATA_DIR=C:\Users\YourName\AppData\Local\AI-JobPilot\chrome-profile
# APP_BROWSER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# SPRING_DATASOURCE_URL=jdbc:sqlite:C:\Users\YourName\Documents\AI-JobPilot\db\getjobs.db
# LOGGING_FILE_NAME=C:\Users\YourName\Documents\AI-JobPilot\logs\get-jobs.log

# 浏览器配置
APP_BROWSER_EXECUTABLE_PATH=
APP_BROWSER_CHANNEL=
APP_BROWSER_HEADLESS=false
APP_BROWSER_SLOW_MO_MS=50

# OpenClaw 实验通路，可不配置。Windows 如需使用，请指向 openclaw.cmd。
APP_OPENCLAW_COMMAND=
APP_OPENCLAW_PROFILE=openclaw
APP_OPENCLAW_DETAIL_LIMIT=5

# AI / 模型配置。真实值建议在网页端 AI 配置里填写，或只写入本机 .env。
OPENAI_API_KEY=
HUAWEI_API_KEY=
BASE_URL=
API_KEY=
MODEL=
OLLAMA_BASE_URL=http://host.docker.internal:11434
